{
  "name": "web-mindmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "licenses": "tsx scripts/licenses.ts",
    "security:files": "node scripts/check-publication.mjs",
    "security:staged": "gitleaks git --staged --redact && node scripts/check-publication.mjs --staged",
    "security:history": "gitleaks git --redact --log-opts=--all",
    "security:audit": "npm audit --audit-level=high",
    "security:hooks": "pre-commit install"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
